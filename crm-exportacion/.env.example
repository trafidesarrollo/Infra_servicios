# Usuario de GitHub/organización dueño del paquete en GHCR
GITHUB_USERNAME=mgmg311283-png

# Conexión a la base compartida de Infra Servicios (usuario crm_exportacion,
# ya creado ahí con CREATEDB — ver ../init-db). La base "crm_exportacion" NO
# se crea sola: hay que crearla una vez (CREATE DATABASE crm_exportacion
# OWNER crm_exportacion;) y correr "npm run db:push" desde el repo de la app
# apuntando a esa base antes del primer arranque.
DATABASE_URL=postgresql://crm_exportacion:<CRM_EXPORTACION_DB_PASSWORD>@postgres:5432/crm_exportacion

# Puerto publicado al host (distinto del resto de los servicios para no chocar)
APP_PORT=8083

# Secreto para firmar sesiones (generá uno con: openssl rand -hex 32)
SESSION_SECRET=cambiar-por-string-aleatorio-largo

# Opcional: solo si se quiere habilitar el login "Replit Auth" (OIDC).
# Si se dejan vacías, ese botón queda oculto y solo funciona el login local.
REPL_ID=
ISSUER_URL=
