# Usuario de GitHub/organización dueño del paquete en GHCR
GITHUB_USERNAME=trafidesarrollo

# Conexión a la base compartida de Infra Servicios (usuario sumin_stockintermedio,
# ya creado ahí con CREATEDB). La base se crea sola al primer arranque.
DATABASE_URL=postgresql://sumin_stockintermedio:<SUMIN_STOCKINTERMEDIO_DB_PASSWORD>@postgres:5432/sumin_stockintermedio

# Puerto publicado al host (distinto del de brica-stockintermedio para no chocar)
APP_PORT=8081

# Admin de la app
SEED_ADMIN_EMAIL=ventas@traficano.com
ADMIN_PASSWORD=cambiar-esta-password

# SMTP (SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_USER=apikey
SMTP_PASS=
MAIL_FROM=tumail@tudominio.com
NOTIFY_EMAIL=tumail@tudominio.com
