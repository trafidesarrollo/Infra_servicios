# Usuario de GitHub/organización dueño del paquete en GHCR
GITHUB_USERNAME=trafidesarrollo

# Conexión a la base compartida de Infra Servicios
DATABASE_URL=postgresql://mail_organizer:<MAIL_ORGANIZER_DB_PASSWORD>@postgres:5432/mail_organizer

# Puerto publicado al host
APP_PORT=8082

# Secreto para firmar sesiones (generá uno con: openssl rand -hex 32)
SESSION_SECRET=cambiar-por-string-aleatorio-largo

# Google OAuth (creá la app en console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública de la app (usada para construir el redirect URI de OAuth)
APP_URL=https://mail.traficano.com

# OpenAI (para clasificación de emails)
OPENAI_API_KEY=
